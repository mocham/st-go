{
  "font": "Monaco_Linux.ttf",
  "borderpx": 1,
  "glyphwidth": 16,
  "glyphheight": 28,
  "glyphbaseline": 24,
  "shell": "/bin/sh",
  "utmp": "",
  "scroll": "",
  "stty_args": "stty raw pass8 nl -echo -iexten -cstopb 38400",
  "vtiden": "\u001b[?6c",
  "worddelimiters": " ",
  "allowaltscreen": true,
  "allowwindowops": false,
  "allowgeometryops": true,
  "termname": "st-256color",
  "tabspaces": 8,
  "colorname": [
    "#181818", "#ac4242", "#90a959", "#f4bf75",
    "#6a9fb5", "#aa759f", "#75b5aa", "#d8d8d8",
    "#6b6b6b", "#c55555", "#aac474", "#feca88",
    "#82b8c8", "#c28cb8", "#93d3c3", "#f8f8f8",
    "#cccccc", "#555555", "#add8e6", "#181818"
  ],
  "defaultfg": 258,
  "defaultbg": 259,
  "defaultcs": 256,
  "defaultrcs": 257,
  "cursorshape": 2,
  "cols": 80,
  "rows": 24,
  "mouseshape": 0,
  "mousefg": 7,
  "mousebg": 0,
  "forcemousemod": 1,
  "ignoremod": 2,
  "doubleclicktimeout": 300,
  "tripleclicktimeout": 600,
  "minlatency": 2,
  "maxlatency": 33,
  "blinktimeout": 800,
  "cursorthickness": 2,
  "bellvolume": 0,
  "webp_cache_path": "/tmp/st-go-webp-cache-{uid}/cache.sqlite3",
  "file_browser": {
    "icons": {
      "parent": "↑",
      "directory": "▸",
      "symlink": "↗",
      "image": "▣",
      "pdf": "▤",
      "text": "≡",
      "archive": "▦",
      "audio": "♪",
      "video": "▶",
      "code": "λ",
      "config": "⚙",
      "executable": "◆",
      "default": "·"
    }
  },
  "selmasks": [0, 0, 8],
  "mshortcuts": [
    { "mask": 0, "button": 2, "action": "selpaste", "arg": "", "release": true },
    { "mask": 0, "button": 4, "action": "ttysend", "arg": "\u0019" },
    { "mask": 0, "button": 5, "action": "ttysend", "arg": "\u0005" },
    { "mask": 1, "button": 4, "action": "ttysend", "arg": "\u001b[5;2~" },
    { "mask": 1, "button": 5, "action": "ttysend", "arg": "\u001b[6;2~" }
  ],
  "shortcuts": [
    { "mask": 0, "keysym": "Break", "action": "sendbreak" },
    { "mask": 4, "keysym": "Print", "action": "toggleprinter" },
    { "mask": 1, "keysym": "Print", "action": "printscreen" },
    { "mask": 0, "keysym": "Print", "action": "printsel" },
    { "mask": 5, "keysym": "Prior", "action": "zoom", "arg": "+1" },
    { "mask": 5, "keysym": "Next", "action": "zoom", "arg": "-1" },
    { "mask": 5, "keysym": "Home", "action": "zoomreset" },
    { "mask": 5, "keysym": "C", "action": "clipcopy" },
    { "mask": 5, "keysym": "V", "action": "clippaste" },
    { "mask": 5, "keysym": "Y", "action": "selpaste" },
    { "mask": 1, "keysym": "Insert", "action": "selpaste" }
  ],
  "keymap": []
}
