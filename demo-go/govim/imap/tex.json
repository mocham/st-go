{
  "filetypes": [".tex", ".ltx", ".latex", ".sty", ".cls"],
  "placeholder": "<++>",
  "defaults": {"not_after": ["`", "\\", "\""]},
  "imap": [
    {"lhs": "`a", "rhs": "\\alpha"},
    {"lhs": "`b", "rhs": "\\beta"},
    {"lhs": "`c", "rhs": "\\chi"},
    {"lhs": "`d", "rhs": "\\delta"},
    {"lhs": "`e", "rhs": "\\varepsilon"},
    {"lhs": "`f", "rhs": "\\varphi"},
    {"lhs": "`g", "rhs": "\\gamma"},
    {"lhs": "`h", "rhs": "\\eta"},
    {"lhs": "`i", "rhs": "\\iota"},
    {"lhs": "`k", "rhs": "\\kappa"},
    {"lhs": "`l", "rhs": "\\lambda"},
    {"lhs": "`m", "rhs": "\\mu"},
    {"lhs": "`n", "rhs": "\\nu"},
    {"lhs": "`p", "rhs": "\\pi"},
    {"lhs": "`q", "rhs": "\\theta"},
    {"lhs": "`r", "rhs": "\\rho"},
    {"lhs": "`s", "rhs": "\\sigma"},
    {"lhs": "`t", "rhs": "\\tau"},
    {"lhs": "`u", "rhs": "\\upsilon"},
    {"lhs": "`v", "rhs": "\\varsigma"},
    {"lhs": "`w", "rhs": "\\omega"},
    {"lhs": "`x", "rhs": "\\xi"},
    {"lhs": "`y", "rhs": "\\psi"},
    {"lhs": "`z", "rhs": "\\zeta"},
    {"lhs": "`D", "rhs": "\\Delta"},
    {"lhs": "`F", "rhs": "\\Phi"},
    {"lhs": "`G", "rhs": "\\Gamma"},
    {"lhs": "`L", "rhs": "\\Lambda"},
    {"lhs": "`P", "rhs": "\\Pi"},
    {"lhs": "`Q", "rhs": "\\Theta"},
    {"lhs": "`S", "rhs": "\\Sigma"},
    {"lhs": "`U", "rhs": "\\Upsilon"},
    {"lhs": "`W", "rhs": "\\Omega"},
    {"lhs": "`X", "rhs": "\\Xi"},
    {"lhs": "`Y", "rhs": "\\Psi"}
  ],
  "templates": {
    "environment": "\\begin{${name}}\n<++>\n\\end{${name}}<++>",
    "package": "\\usepackage{${name}}<++>"
  }
}
